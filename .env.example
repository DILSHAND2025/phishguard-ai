# MAVERICK Cybersecurity Platform — Environment Variables
# Smart India Hackathon 2026

# Google Identity Services / OAuth 2.0 Client ID (Web Application)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth Client ID
# Authorized JavaScript Origins: http://localhost:5173
# Authorized Redirect URIs: http://localhost:5173/maverick/
VITE_GOOGLE_CLIENT_ID=

# Port for optional backend gateway
PORT=5000

# Render / Cloud Backend Gateway Endpoint (used by frontend to route ML and threat queries)
# Example: https://maverick-backend.onrender.com
VITE_API_URL=

# VirusTotal v3 API Key (optional threat intelligence feed)
VIRUSTOTAL_API_KEY=

# AbuseIPDB v2 API Key (optional IP reputation feed)
ABUSEIPDB_API_KEY=
